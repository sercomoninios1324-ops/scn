{
  "name": "scn-catalogo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "build": "vite build && esbuild server/app.ts --bundle --platform=node --target=node20 --format=cjs --packages=external --outfile=api/bundle.cjs",
    "start": "tsx server/prod.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "migrate:images": "tsx scripts/migrate-product-images.ts",
    "migrate:images:supabase": "tsx scripts/migrate-product-images.ts --supabase",
    "fill:shorts": "tsx scripts/fill-short-descriptions.ts",
    "fill:shorts:supabase": "tsx scripts/fill-short-descriptions.ts --supabase",
    "check:supabase": "tsx scripts/check-supabase.ts",
    "admin": "tsx scripts/admin-access.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "ogl": "^1.0.11",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.21.4",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": "26.x"
  }
}
