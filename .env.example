# ─────────────────────────────────────────────────────────────────────
# SCN — Variables de entorno
# Local: copiar este archivo como .env y completar.
# Vercel: Project → Settings → Environment Variables (Production + Preview).
# NUNCA commitear .env ni pegar la service role key en el front.
# ─────────────────────────────────────────────────────────────────────

# Dominio canónico (SEO, sitemap, links de WhatsApp, CORS)
SITE_URL=https://somos-scn.com.ar
VITE_SITE_URL=https://somos-scn.com.ar

# Supabase — proyecto existente (Dashboard → Project Settings → API)
SUPABASE_URL=https://vanlkqadbdplussonwuf.supabase.co
VITE_SUPABASE_URL=https://vanlkqadbdplussonwuf.supabase.co

# "anon public" key (va en las dos)
SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=

# "service_role" key: SOLO servidor / scripts. Nunca con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Solo desarrollo local SIN Supabase (en producción están desactivados)
ADMIN_DEV_TOKEN=scn-dev-admin-token
ADMIN_EMAIL=
ADMIN_PASSWORD=
